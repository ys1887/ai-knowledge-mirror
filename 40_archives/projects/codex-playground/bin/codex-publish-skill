#!/usr/bin/env python3
import argparse
import filecmp
import shutil
import sys
from pathlib import Path


SOURCE_ROOT_DEFAULT = Path(r"E:\Documents\Playground\lib-skills")
DEST_ROOT_DEFAULTS = [Path(r"C:\Users\nekol\.codex\skills")]
WSL_RUNTIME_ROOT = r"\\wsl.localhost\Ubuntu\home\ys\.codex\skills"
IGNORED_DIR_NAMES = {".git", "__pycache__"}
IGNORED_FILE_SUFFIXES = {".pyc", ".pyo"}


def resolve_path(path: Path) -> Path:
    return path.expanduser().resolve(strict=False)


def is_under(path: Path, root: Path) -> bool:
    path = resolve_path(path)
    root = resolve_path(root)
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return str(path).lower() == str(root).lower()


def assert_safe_roots(source_root: Path, dest_roots: list[Path]) -> None:
    if not is_under(source_root, SOURCE_ROOT_DEFAULT):
        raise SystemExit(f"error: unsafe source root: {resolve_path(source_root)}")

    for dest_root in dest_roots:
        dest_full = resolve_path(dest_root)
        is_windows_runtime = is_under(dest_full, Path(r"C:\Users\nekol\.codex\skills"))
        is_wsl_runtime = str(dest_full).lower().startswith(WSL_RUNTIME_ROOT.lower())
        if not (is_windows_runtime or is_wsl_runtime):
            raise SystemExit(f"error: unsafe destination root: {dest_full}")


def validate_skill_name(skill: str) -> None:
    if skill == ".system" or skill.startswith(".") or "/" in skill or "\\" in skill:
        raise SystemExit(f"error: unsupported skill name: {skill}")


def get_skill_source_dir(source_root: Path, skill: str) -> Path:
    validate_skill_name(skill)
    candidates = [
        source_root / skill,
        source_root / "codex" / skill,
    ]

    for candidate in candidates:
        if candidate.is_dir() and (candidate / "SKILL.md").is_file():
            return resolve_path(candidate)

    raise SystemExit(f"error: managed skill not found in source root: {skill}")


def list_managed_skills(source_root: Path) -> list[str]:
    names: set[str] = set()
    for root in (source_root, source_root / "codex"):
        if not root.is_dir():
            continue
        for child in root.iterdir():
            if child.name != ".system" and child.is_dir() and (child / "SKILL.md").is_file():
                names.add(child.name)
    return sorted(names, key=str.lower)


def iter_files(root: Path) -> dict[str, Path]:
    if not root.is_dir():
        return {}
    return {
        str(path.relative_to(root)): path
        for path in root.rglob("*")
        if path.is_file() and not should_ignore(path.relative_to(root))
    }


def should_ignore(relative: Path) -> bool:
    if any(part in IGNORED_DIR_NAMES for part in relative.parts):
        return True
    return relative.suffix.lower() in IGNORED_FILE_SUFFIXES


def iter_runtime_source_files(source_dir: Path) -> dict[str, Path]:
    windows_runtime_dir = source_dir / "runtime" / "windows"
    if windows_runtime_dir.is_dir() and (windows_runtime_dir / "SKILL.md").is_file():
        return iter_files(windows_runtime_dir)
    return iter_files(source_dir)


def get_skill_diff(source_dir: Path, dest_dir: Path) -> list[str]:
    source_files = iter_runtime_source_files(source_dir)
    dest_files = iter_files(dest_dir)
    changes: list[str] = []

    for relative in sorted(source_files, key=str.lower):
        if relative not in dest_files:
            changes.append(f"ADD {relative}")
        elif not filecmp.cmp(source_files[relative], dest_files[relative], shallow=False):
            changes.append(f"UPDATE {relative}")

    for relative in sorted(dest_files, key=str.lower):
        if relative not in source_files:
            changes.append(f"EXTRA {relative}")

    return changes


def remove_extra_dest_files(source_dir: Path, dest_dir: Path) -> None:
    source_files = set(iter_runtime_source_files(source_dir))
    for relative, dest_file in iter_files(dest_dir).items():
        if relative not in source_files:
            dest_file.unlink()

    for directory in sorted(
        (path for path in dest_dir.rglob("*") if path.is_dir()),
        key=lambda path: len(path.parts),
        reverse=True,
    ):
        try:
            directory.rmdir()
        except OSError:
            pass


def copy_tree(source_dir: Path, dest_dir: Path, delete: bool) -> None:
    dest_dir.mkdir(parents=True, exist_ok=True)
    for relative, source_file in iter_runtime_source_files(source_dir).items():
        dest_file = dest_dir / relative
        dest_file.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source_file, dest_file)

    if delete:
        remove_extra_dest_files(source_dir, dest_dir)


def publish_skill_to_dest(skill: str, source_dir: Path, dest_root: Path, dry_run: bool, delete: bool) -> None:
    dest_dir = dest_root / skill
    print(f"==> {skill}")
    print(f"    source: {resolve_path(source_dir)}")
    print(f"    dest:   {resolve_path(dest_dir)}")

    if dry_run:
        changes = get_skill_diff(source_dir, dest_dir)
        if not changes:
            print("    OK no changes")
        else:
            for change in changes:
                print(f"    {change}")
        return

    copy_tree(source_dir, dest_dir, delete)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Publish managed skills from lib-skills into configured Codex runtime copies."
    )
    parser.add_argument("skills", nargs="*", help="skill names to publish")
    parser.add_argument("--all", action="store_true", help="publish every managed skill except .system")
    parser.add_argument("--dry-run", action="store_true", help="show source/runtime differences without writing")
    parser.add_argument("--delete", action="store_true", help="remove destination files that no longer exist in source")
    parser.add_argument("--source", type=Path, default=SOURCE_ROOT_DEFAULT, help=f"source root, default: {SOURCE_ROOT_DEFAULT}")
    parser.add_argument("--dest", action="append", type=Path, help=f"destination root override, default: {DEST_ROOT_DEFAULTS[0]}")
    return parser


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    source_root = args.source
    dest_roots = args.dest if args.dest else DEST_ROOT_DEFAULTS
    assert_safe_roots(source_root, dest_roots)

    if not source_root.is_dir():
        raise SystemExit(f"error: source root not found: {source_root}")

    skills = list_managed_skills(source_root) if args.all else args.skills
    if not skills:
        parser.print_usage()
        return 1

    print(f"source root: {resolve_path(source_root)}")
    for dest_root in dest_roots:
        print(f"dest root:   {resolve_path(dest_root)}")
    mode = "dry-run" if args.dry_run else "apply"
    if args.delete:
        mode += " + delete"
    print(f"mode:        {mode}")

    for skill in skills:
        source_dir = get_skill_source_dir(source_root, skill)
        for dest_root in dest_roots:
            publish_skill_to_dest(skill, source_dir, dest_root, args.dry_run, args.delete)

    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
